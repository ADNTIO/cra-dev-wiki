/* 128 x 64 OLED screen (SSD1306) of the Heltec board, on the internal I2C bus.
 * Power (Vext) and the reset pin are handled by board_init.c.
 */

/ {
	chosen {
		zephyr,display = &oled;
	};
};

&i2c0 {
	oled: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
	};
};
