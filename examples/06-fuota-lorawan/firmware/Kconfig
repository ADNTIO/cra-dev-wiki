mainmenu "LoRaWAN FUOTA example"

choice APP_TRANSPORT
	prompt "Update transport"
	default APP_TRANSPORT_LORAWAN

config APP_TRANSPORT_LORAWAN
	bool "LoRaWAN: OTAA join and FUOTA services (TS003, TS004, TS005)"

config APP_TRANSPORT_P2P
	bool "Point-to-point LoRa, from another board, without a LoRaWAN network"
	help
	  For a bench without a gateway: a second board broadcasts the image as
	  TS004 fragments (see radio-modem/ and tools/p2p_send.py). The decoder,
	  the flash writes and MCUboot are the same as with LoRaWAN.

endchoice

config APP_LORAWAN_DEV_EUI
	string "DevEUI (16 hex characters)"
	default "0000000000000000"

config APP_LORAWAN_JOIN_EUI
	string "JoinEUI (16 hex characters)"
	default "0000000000000000"

config APP_LORAWAN_APP_KEY
	string "AppKey (32 hex characters)"
	default "00000000000000000000000000000000"
	help
	  Never put a real key in prj.conf: pass it through a file kept out of
	  the repository, with -DEXTRA_CONF_FILE.

config APP_JOIN_ATTEMPTS
	int "Join attempts before giving up"
	range 0 20
	default 3
	help
	  At 0, the device transmits nothing: useful on a bench without an antenna.

config APP_UPLINK_PERIOD
	int "Uplink period, in seconds"
	default 180

config APP_SELFTEST_REQUIRES_JOIN
	bool "Only confirm a new image after a successful join"
	default y
	help
	  Health check of an image booted on trial. If the join fails, the device
	  reboots and MCUboot restores the previous image. Only disable it on a
	  bench without a LoRaWAN gateway: the check then becomes "the radio
	  answers".

source "Kconfig.zephyr"
